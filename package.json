{
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "commander": "^12.0.0",
    "docopt": "^0.6.2",
    "dotenv": "^16.6.1",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "playwright": "^1.58.2",
    "playwright-core": "^1.58.2",
    "protobufjs": "^7.2.6",
    "react": "^18.2.0",
    "ws": "^8.19.0"
  },
  "name": "@helloandre/glycerin",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "gln": "./dist/src/index.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/index.js",
    "dev": "ts-node --esm src/index.ts",
    "debug": "node --inspect-brk -r ts-node/register src/index.ts",
    "test:events": "ts-node --esm test-events.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "reinstall": "rm -rf node_modules package-lock.json && npm install"
  }
}
