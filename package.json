    "leave": "ts-node src/index.ts leave",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "reinstall": "rm -rf node_modules package-lock.json && npm install"
